# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration (cascade router — src/services/llm.py) ----
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
# Model rẻ cho classify/reason/routing (tiết kiệm cost)
MODEL_CLASSIFY=gpt-4o-mini
# Model mạnh cho sinh câu trả lời cuối
MODEL_GENERATE=gpt-4o
# Judge PHẢI khác MODEL_GENERATE (chống self-preference bias — app sẽ raise nếu trùng)
MODEL_JUDGE=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2048

# ---- Agent loop ----
# Số vòng ReAct tối đa trước khi escape hatch -> finalize_with_partial
AGENT_MAX_ITERATIONS=8
# Or use other providers (set LLM_PROVIDER accordingly):
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=google
# GOOGLE_API_KEY=
# ---- Database ----
# docker-compose tự đặt DATABASE_URL tới Postgres; chạy local không Docker thì dùng SQLite:
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql://vin15:vin15@localhost:5432/vin15

# ---- VIN-15: Hệ thống hỗ trợ thực tập ----
# ĐỔI khi triển khai thật — dùng ký JWT và URL tải file
JWT_SECRET=dev-only-change-me
JWT_TTL_MINUTES=480
FILE_URL_TTL_SECONDS=300
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
COHORT_CONFIG=config/cohort.yaml
POLICY_SEED_DIR=seed/policies
# Vai trò tùy chọn Quản trị viên. false → cấu hình từ YAML/seed, kho quy định do GV điều phối quản lý
ENABLE_ADMIN_ROLE=true
# Seed dữ liệu demo tổng hợp khi DB trống (mật khẩu demo123)
SEED_DEMO_DATA=true
MONITOR_ENABLED=true
MONITOR_HOUR=7
RETRIEVAL_MIN_SCORE=2.0
RETRIEVAL_MIN_COVERAGE=0.4
RETRIEVAL_TOP_K=4
# Embedding cho kho quy định — chỉ dùng khi có OPENAI_API_KEY; sau khi thêm key gọi POST /api/v1/policies/reindex
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MIN_SIMILARITY=0.5
EMBEDDING_WEIGHT=8.0

# Endpoint tương thích OpenAI (để trống = api.openai.com). Ví dụ Ollama: http://ollama:11434/v1
# — xem deploy/docker-compose.llm.yml
OPENAI_BASE_URL=

# ---- Giới hạn tần suất (in-memory, một process) ----
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
LOGIN_IP_PER_MINUTE=30
ASSISTANT_PER_MINUTE=20
INTAKE_PER_MINUTE=10

# ---- HTTPS (Caddy trong docker-compose) ----
# localhost → chứng chỉ CA nội bộ của Caddy; tên miền thật → Let's Encrypt tự động
SITE_ADDRESS=localhost

# ---- SSO/OIDC (để trống OIDC_ISSUER = tắt) ----
# Ví dụ Keycloak: https://sso.truong.edu.vn/realms/sinhvien
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://localhost/api/v1/auth/oidc/callback
OIDC_SCOPES=openid email profile

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
